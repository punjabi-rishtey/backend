# Copy to `.env` for local development. Never commit real secrets.
# For demo mode, see `.env.demo.example` and `npm run dev:demo`.

MONGO_URI=mongodb://127.0.0.1:27017/punjabi-rishtey
PORT=8080

# Member session tokens (login, protect middleware, member APIs)
JWT_SECRET=replace-with-cryptographically-random-member-secret

# Admin dashboard tokens (separate from member tokens since chunk 4)
ADMIN_JWT_SECRET=replace-with-cryptographically-random-admin-secret

FRONTEND_URL=http://127.0.0.1:5173

# Optional: Cloudinary, SMTP, OpenAI moderation — configure as needed for full features